[Unit]
Description=Continuum BMC state and event telemetry
After=network-online.target nmc-server.service
Wants=network-online.target
ConditionPathExists=/etc/nmc/bmc-observer.json

[Service]
Type=simple
User=nmc
Group=nmc
WorkingDirectory=/var/lib/nmc
Environment=HOME=/var/lib/nmc
EnvironmentFile=-/etc/nmc/bmc-observer.env
ExecStart=/usr/bin/flock --nonblock /var/lib/nmc/bmc-observer.lock /usr/lib/nmc-server/nmc-bmc-observer /etc/nmc/bmc-observer.json
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nmc
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
